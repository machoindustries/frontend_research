@using ANA.Site.Business.Constants
@using ANA.Site.Business.Extensions
@using ANA.Site.Business.Helpers
@using ANA.Site.Business.State
@using ANA.Site.Models.Media
@using DocumentFormat.OpenXml.Wordprocessing
@using EPiServer.Core
@using EPiServer.Framework.Web.Mvc.Html
@using EPiServer.Web
@using EPiServer.Web.Mvc.Html
@using Geta.Optimizely.Extensions;

@model ANA.Site.Models.ViewModels.IPageViewModel<ANA.Site.Business.Interfaces.ICommonProperties>
@{
    var hubSettingsBlockViewModel = Model.HubSettingsBlockViewModel;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@(Model.CurrentPage.MetaTitle ?? (Model.CurrentPage.Name ?? string.Empty + " | " + Model.Layout.SiteName ?? string.Empty))</title>
    <meta name="description" content="@(Model.CurrentPage.MetaDescription ?? Model.CurrentPage.SocialDescription ?? Model.CurrentPage.Description)" />

    <link rel="canonical" href="@(string.IsNullOrEmpty(Model.CurrentPage.CanonicalLink) ? SiteDefinition.Current.SiteUrl.ToString().TrimEnd('/') + Model.CurrentPage.ContentLink.GetFriendlyUrl(false, true) : Model.CurrentPage.CanonicalLink)" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">

    <meta property="og:title" content="@(Model.CurrentPage.SocialTitle ?? Model.CurrentPage.Name)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@(SiteDefinition.Current.SiteUrl.ToString().TrimEnd('/') + Model.CurrentPage.ContentLink.GetFriendlyUrl(false, true))" />
    @{
        ImageFile imageData = null;
        if (Model.CurrentPage.OpenGraphImage != null)
        {
            imageData = Model.CurrentPage.OpenGraphImage.Get<ImageFile>();
        }
        if (imageData == null && Model.Layout.DefaultSocialImage != null)
        {
            imageData = Model.Layout.DefaultSocialImage.Get<ImageFile>();
        }
        if (imageData != null)
        {
            <meta property="og:image" content="@imageData.GetCroppedImageUrl(1200, 630, true)" />
            <meta name="twitter:image" content="@imageData.GetCroppedImageUrl(300, 300, true)" />
        }
    }
    <meta property="og:site_name" content="@Model.Layout.SiteName" />
    <meta property="og:description" content="@(Model.CurrentPage.SocialDescription ?? Model.CurrentPage.Description)" />
    <meta property="article:published_time" content="@Model.CurrentPage.StartPublish.Value.ToString("s")" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@("@" + (Model.Layout.TwitterSite ?? "ananursingworld"))" />
    <meta name="twitter:title" content="@(Model.CurrentPage.SocialTitle ?? Model.CurrentPage.Name)" />
    <meta name="twitter:description" content="@(Model.CurrentPage.SocialDescription ?? Model.CurrentPage.Description)" />

    @if (!string.IsNullOrEmpty(Model.CurrentPage.DisableIndexing))
    {
        <meta name="robots" content="@Model.CurrentPage.DisableIndexing" />
    }
    else
    {
        <meta name="robots" content="@Model.CurrentPage.MetaRobots" />
    }

    <meta name="viewport" content="width=device-width, initial-scale=1, minimal-ui" />

    <meta name="theme-color" content="#C92027" />

    <link rel="shortcut icon" href="/assets/img/logos/favicon.ico" type="image/icon" />

    <link href="https://fonts.googleapis.com/css?family=Lato:400,100,100italic,300,300italic,400italic,700,700italic,900italic,900&subset=latin,latin-ext" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="~/Hub/Static/main.css">
    @* Single jQuery for this layout. Loaded here in <head> because
       hubsearch.js below and anything injected via
       RequiredClientResources("Header") may expect it. Previously this
       pulled the unminified 285KB jquery.js and /bundles/jquery was
       loaded again near </body>, so jQuery executed twice and the second
       instance replaced the first. *@
    <script src="/bundles/jquery"></script>

    <script type="text/javascript" src="~/Hub/Static/assets/javascripts/hubsearch.js"></script>
    <script type="text/javascript" src="~/Hub/Static/assets/anime.min.js"></script>
    <script type="text/javascript" src="~/Hub/Static/script.js"></script>

    <link rel="stylesheet" href="/styles/screen" asp-append-version="true" />
    <link rel="stylesheet" href="/styles/print" media="print" asp-append-version="true" />

    <script src="/bundles/moderniz"></script>


    <!--[if gt IE 8]><!-->
    @Html.RequiredClientResources("Header")
    <!--<![endif]-->

    @if (!string.IsNullOrWhiteSpace(Model.Layout.GlobalHeadScripts))
    {
        @Html.Raw(Model.Layout.GlobalHeadScripts)
    }

    @if (!string.IsNullOrWhiteSpace(Model.CurrentPage.HeadScripts))
    {
        @Html.Raw(Model.CurrentPage.HeadScripts)
    }

    @RenderSection("HeadEnd", false)
</head>

@{
    var bodyClasses = new List<string>
{
        "body",
        Model.CurrentPage.PageTypeName.ToValidClassName(),
        Model.CurrentPage.BodyCssClass
    };
}

<body data-require="./src/views/page-view" id="top" class="@string.Join(" ", bodyClasses.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray())"
      data-logged-in-user-id="@UserState.CurrentProfile.CustomerId"
      data-logged-in-user-member-status="@UserState.CurrentProfile.MemberType"
      data-logged-in-user-registered-state="@UserState.CurrentProfile.State"
      data-page-heading="@Model.CurrentPage.Heading">
    @if (!string.IsNullOrWhiteSpace(Model.Layout.GlobalBodyScripts))
    {
        @Html.Raw(Model.Layout.GlobalBodyScripts)
    }
    @if (!string.IsNullOrWhiteSpace(Model.CurrentPage.BodyScripts))
    {
        @Html.Raw(Model.CurrentPage.BodyScripts)
    }
    @await Html.RenderEPiServerQuickNavigatorAsync()
    @Html.FullRefreshPropertiesMetaData()

    @if (!Model.Layout.IsHeaderHidden)
    {
        await Html.RenderPartialAsync("Header", Model);
    }

    <div class="main-container">
        <div class="top-container">
            <div class="menu-container" id="menu">
                <div class="links-wrapper">
                    @if (hubSettingsBlockViewModel?.CategoryLinks?.Any() == true)
                    {
                        foreach (var item in hubSettingsBlockViewModel.CategoryLinks)
                        {
                            <a href="@item.LinkUrl" class="menu-link" target="@item.LinkTarget">
                                <span>@item.LinkTitle</span>
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     height="1em"
                                     viewBox="0 0 320 512"
                                     fill="currentColor">
                                    <path d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256 73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z" />
                                </svg>
                            </a>
                        }
                    }

                </div>
                @if (!string.IsNullOrWhiteSpace(hubSettingsBlockViewModel.CtaLinkUrl) && !string.IsNullOrWhiteSpace(hubSettingsBlockViewModel.ImageUrl))
                {
                    <div class="featured-wrapper">
                        <a href="@hubSettingsBlockViewModel.CtaLinkUrl" class="featured-container">
                            <img src="@hubSettingsBlockViewModel.ImageUrl" alt="@hubSettingsBlockViewModel.ImageAlt" title="@hubSettingsBlockViewModel.ImageAlt" class="featured-image">
                        </a>
                    </div>
                }
                <div class="close-button" id="closeButton">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         height="1em"
                         viewBox="0 0 384 512"
                         fill="currentColor">
                        <path d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z" />
                    </svg>
                </div>
            </div>
            <div class="header-container">
                <div class="header-content-wrapper">
                    @if (hubSettingsBlockViewModel?.CurrentBlock?.ContentHubName != null && !string.IsNullOrEmpty(hubSettingsBlockViewModel.CurrentBlock.ContentHubName))
                        {
                            var hubHomePageUrl = SettingsHelper.GetSettings()?.HubHomePage?.GetFriendlyUrl(false, true);
                        <a href="@hubHomePageUrl" class="title-wrapper">
                            <h2 class="title">@hubSettingsBlockViewModel.CurrentBlock.ContentHubName</h2>
                        </a>
                    }

                <div class="search-input-wrapper" id="searchBlock">
                    @if (!string.IsNullOrEmpty(hubSettingsBlockViewModel.CurrentBlock.SearchBoxPlaceholderTextMobile))
                    {
                        <p class="search-title">@hubSettingsBlockViewModel.CurrentBlock.SearchBoxPlaceholderTextMobile</p>
                }
                @if (hubSettingsBlockViewModel?.SearchPageUrl != null && !string.IsNullOrEmpty(hubSettingsBlockViewModel.SearchPageUrl))
                    {
                        <form action="@hubSettingsBlockViewModel.SearchPageUrl" class="search-input-form" id="headerSearchForm">
                            @{ var placeHolderText = !string.IsNullOrWhiteSpace(hubSettingsBlockViewModel?.CurrentBlock?.SearchBoxPlaceholderText) ? hubSettingsBlockViewModel?.CurrentBlock?.SearchBoxPlaceholderText : string.Empty; }
                            <input id="searchInput" class="search-input" placeholder="@placeHolderText" name="query">
                            <label class="search-input-label">
                                <input type="submit" hidden />
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     height="1em"
                                     viewBox="0 0 512 512"
                                     fill="currentColor">
                                    <path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z" />
                                </svg>
                            </label>
                        </form>
                    }

                    <div class="suggested-container d-none" id="dvSuggestedContainer">
                    </div>
                </div>
                    <div class="search-button-container">
                        <button class="search-button" id="searchToggle">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 height="1em"
                                 viewBox="0 0 512 512"
                                 fill="currentColor">
                                <path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z" />
                            </svg>
                        </button>
                    </div>
                    <div class="burger-button" id="burgerButton">
                        <div class="burger-button-line"></div>
                        <div class="burger-button-line"></div>
                        <div class="burger-button-line"></div>
                    </div>
                </div>
            </div>
        </div>
        @RenderBody()
    </div>

    @if (!Model.Layout.IsFooterHidden)
    {
                    await Html.RenderPartialAsync("Footer", Model);
                }

                @if (Model.Layout.DisplayGridOverlay)
    {
        await Html.RenderPartialAsync("GridOverlay");
                }

    @{
                    var cats = (Model.CurrentPage as ICategorizable).GetPageCategories();
                    var personalisationInfo = Context.GetPersonalisationInfo();
                }

    <div style="display:none;"
         data-gtm-content-groups-info=""
         data-gtm-content-groups-brand="@cats.GetValue("Brand")"
         data-gtm-content-groups-theme="@cats.GetValue("Theme")"
         data-gtm-content-groups-audience="@cats.GetValue("Audience")"
         data-gtm-content-groups-userpurpose="@cats.GetValue("User Purpose")"
         data-gtm-content-groups-topic="@cats.GetValue("Topic")">
    </div>

    @{
        var pOldCart = personalisationInfo.GetValue("OldCart");
                var pHasMemberPrice = personalisationInfo.GetValue("HasMembershipPrice");
                var oldCart = !string.IsNullOrWhiteSpace(pOldCart) && pOldCart.ToLower() == "y" ? "Yes" : "No";
                var hasMembershipPrice = !string.IsNullOrWhiteSpace(pHasMemberPrice) && pHasMemberPrice.ToLower() == "y" ? "Yes" : "No";
    }

    <div style="display:none;"
         data-gtm-personalisation-info=""
         data-gtm-personalisation-checkedroles="@personalisationInfo.GetValue("CheckedRoles")"
         data-gtm-personalisation-oldcart="@oldCart"
         data-gtm-personalisation-hasmembershipprice="@hasMembershipPrice"
         data-gtm-personalisation-state="@personalisationInfo.GetValue("State")">
    </div>

    @{
        await Html.RenderPartialAsync("_LightboxAddedToCartConfirmation");
    }

    @*@Scripts.Render("~/bundles/entryjs")*@

    <script type="text/javascript" src="https://www.youtube.com/iframe_api"></script>
    <script type="module" src="/assets/js/entry.js" asp-append-version="true"></script>

    @if (!string.IsNullOrWhiteSpace(Model.Layout.GlobalFooterScripts))
    {
        @Html.Raw(Model.Layout.GlobalFooterScripts)
    }

    @if (!string.IsNullOrWhiteSpace(Model.CurrentPage.FooterScripts))
    {
        @Html.Raw(Model.CurrentPage.FooterScripts)
    }

    <!--[if gt IE 8]><!-->
    @Html.RequiredClientResources("Footer")
    <!--<![endif]-->

    @* @if (Model.Layout.AddThisKey != "")
    {
         Go to www.addthis.com/dashboard to customize your tools
         TEMP KEY: ra-59a008db77513704 
        <script type="text/javascript" src="//s7.addthis.com/js/300/addthis_widget.js#pubid=@Model.Layout.AddThisKey"></script>
    } *@

    @RenderSection("BodyEnd", false)
<script type="text/javascript" src="https://platform-api.sharethis.com/js/sharethis.js#property=656744663bcaed00121fca7a&product=inline-share-buttons&source=platform" async="async"></script>
</body>
</html>