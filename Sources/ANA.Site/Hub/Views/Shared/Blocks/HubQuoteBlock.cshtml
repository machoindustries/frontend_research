@using EPiServer.Web.Mvc.Html
@model ANA.Site.Hub.Models.Blocks.ViewModels.HubQuoteBlockViewModel

<div class="cat-banner-container">
    <div class="cat-banner">
        @if (Model.CurrentBlock.Thumbnail != null && Model.CurrentBlock.Thumbnail.Image != null)
        {
            <img src="@Url.ContentUrl(Model.CurrentBlock.Thumbnail.Image)" alt="@Html.PropertyFor(m => m.CurrentBlock.Thumbnail.AltText)" class="cat-image"/>
        }
        <div class="content-container">
            <div class="content-wrapper">
                @if (!string.IsNullOrWhiteSpace(Model.AuthorInfo))
                {
                <p class="banner-label animate-text">
                    @Model.AuthorInfo
                </p>
                }
                <div class="quote">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        height="1em"
                        viewBox="0 0 448 512"
                        fill="currentColor"
                    >
                        <path
                            d="M0 216C0 149.7 53.7 96 120 96h8c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8c-30.9 0-56 25.1-56 56v8h64c35.3 0 64 28.7 64 64v64c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V320 288 216zm256 0c0-66.3 53.7-120 120-120h8c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8c-30.9 0-56 25.1-56 56v8h64c35.3 0 64 28.7 64 64v64c0 35.3-28.7 64-64 64H320c-35.3 0-64-28.7-64-64V320 288 216z"
                        />
                    </svg>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Quote))
                {
                    <p class="banner-text">
                        @Model.Quote
                    </p>
                }
            </div>
        </div>
    </div>
</div>