@using EPiServer.Web.Mvc.Html
@model ANA.Site.Hub.Models.Blocks.ViewModels.HubHeroBannerBlockViewModel
<div class="tagline-wrapper">
    <div class="tagline-container">
        <div class="tagline-main">
            <div class="tagline-text-wrapper">
                <h1 class="tagline-title animate-text">@Model.CurrentBlock.Heading</h1>
                <p class="tagline-label">@Model.CurrentBlock.SubHeading</p>
            </div><img src="@Model.HeroImageUrl" alt="@Model.CurrentBlock.AltText" title="@Model.CurrentBlock.AltText" class="tagline-image">
        </div>
        <div class="tagline-overflow-container">
            <div class="overflow-text-wrapper">
                <h3 class="overflow-title">@Model.CurrentBlock.SubSectionHeading</h3>
                <p class="overflow-text">@Model.CurrentBlock.SubSectionSubHeading</p>
            </div>
            @if (Model.IsPopup)
            {
                @Html.PropertyFor(s=> s.CurrentBlock.PopupModalBlock)
            }
            else
            {
                <a target="@Model.CTALinkTarget" href="@Model.CurrentBlock.SubSectionCtaBlock.CtaLinkUrl" class="button-primary" title="@Model.CurrentBlock.SubSectionCtaBlock.CtaText">
                    @Model.CurrentBlock.SubSectionCtaBlock.CtaText
                    @if (Model.CTAIsExternal)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             height="1em"
                             viewBox="0 0 512 512"
                             fill="currentColor">
                            <path d="M320 0c-17.7 0-32 14.3-32 32s14.3 32 32 32h82.7L201.4 265.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L448 109.3V192c0 17.7 14.3 32 32 32s32-14.3 32-32V32c0-17.7-14.3-32-32-32H320zM80 32C35.8 32 0 67.8 0 112V432c0 44.2 35.8 80 80 80H400c44.2 0 80-35.8 80-80V320c0-17.7-14.3-32-32-32s-32 14.3-32 32V432c0 8.8-7.2 16-16 16H80c-8.8 0-16-7.2-16-16V112c0-8.8 7.2-16 16-16H192c17.7 0 32-14.3 32-32s-14.3-32-32-32H80z" />
                        </svg>
                    }
                </a>
            }
        </div>
</div>
</div>
