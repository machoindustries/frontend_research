@using EPiServer.Web.Mvc.Html
@model ANA.Site.Hub.Models.Blocks.ViewModels.HubPopUpModalBlockViewModel


@if (!Model.DisplayOnPageLoad && !string.IsNullOrEmpty(Model.PopupButtonText))
{
    <a id="@Model.CurrentBlock.GetHashCode()-popup-button" class="button-primary">@Model.PopupButtonText</a>
}

<div class="hub-modal @(!Model.DisplayOnPageLoad == true ? "d-none" : "") " id="@Model.CurrentBlock.GetHashCode()">
    <div class="modal-container">
        <div class="info-wrapper">
            <p class="modal-label">
                @Model.Title
            </p>
            <p class="modal-text">
                @Html.PropertyFor(s => s.Description)
                @Html.PropertyFor(s => s.EmbeddedFormOrVideo)
            </p>

            @if (!string.IsNullOrEmpty(Model.CTALink) && !string.IsNullOrEmpty(Model.CTAText))
            {
                <a href="@(Model.CTALink)" class="button-primary secondary">@(Model.CTAText)</a>
            }

            <p class="modal-text-small">
                @Html.PropertyFor(s => s.BottomText)
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.ImageAltText" class="modal-image" />
        }


        <button type="button" class="close-button" id="@Model.CurrentBlock.GetHashCode()-close-button">
            @Model.CloseModalButtonText
            <svg xmlns="http://www.w3.org/2000/svg"
                 height="1em"
                 viewBox="0 0 384 512"
                 fill="currentColor">
                <path d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z" />
            </svg>
        </button>
    </div>
</div>


<script>
            document.addEventListener("DOMContentLoaded", function () {
                const hubModal = document.getElementById("@Model.CurrentBlock.GetHashCode()");
                if (!hubModal) return;
                const hubModalClose = document.getElementById("@Model.CurrentBlock.GetHashCode()-close-button");
                hubModalClose.addEventListener("click", () => {
                    hubModal.classList.add("d-none");
                });
            });
</script>

@if (!Model.DisplayOnPageLoad)
{
    <script>
        document.getElementById("@Model.CurrentBlock.GetHashCode()-popup-button").addEventListener("click", function () {
            debugger
            toggleModal("@Model.CurrentBlock.GetHashCode()");
          });

          function toggleModal(modalId) {
            var modal = document.getElementById(modalId);
            modal.classList.toggle("d-none");
          }
    </script>
}


