@model ANA.Site.Models.ViewModels.LegacySearchViewModel<ANA.Site.Models.Pages.SearchPage>
@{
    var context = ServiceLocator.Current.GetInstance<IHttpContextAccessor>();
    bool isAjaxCall = context.HttpContext?.Request.Headers["x-requested-with"].ToString() == "XMLHttpRequest";

    if (isAjaxCall)
    {
        Layout = null;
    }
}
<div class="row category-page">
    @if (Model.HasError)
    {
        <div class="col-md-12 text-danger">@Model.ErrorMessage</div>
    }
    else
    {
        { await Html.RenderPartialAsync("_Facet", Model.FilterOption); }
        using (Html.BeginForm("Index", "SearchPage", FormMethod.Get, new { @class = "jsSearchForm" }))
        {
            <div class="col-md-9">
                @{ await Html.RenderPartialAsync("_ProductList", Model.ProductViewModels); }
            </div>
            <input class="jsSearchPage" id="FilterOption_Page" name="FilterOption.Page" type="hidden" value="@(Model.FilterOption.Page + 1)" />
        }
    }
</div>