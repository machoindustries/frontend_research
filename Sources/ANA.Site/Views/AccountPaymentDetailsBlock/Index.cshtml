@model ANA.Site.Models.ViewModels.AccountPaymentDetailsViewModel

<div class="c-account__section" data-require="./src/views/account-payment-details-view">
    <h4 class="c-account__title">@Html.PropertyFor(x => x.Heading)</h4>
    <div class="c-account__intro e-richtext">
        @Html.PropertyFor(x => x.Description)
    </div>
    <div class="grid" data-account-payment-details-items=""></div>
    <div class="grid" data-account-payment-details-no-results="" style="display:none;">
        <div class="grid__item">@Html.Translate("/MyAccount/PaymentDetails/NoResults")</div>
    </div>
    <div class="e-lightbox-source">
        <div data-lightbox-src="removepaymentconfirmation">
            <h3>Remove this payment method?</h3>
            <a href="#" class="e-button e-button--anchor e-button--blue e-button" data-modal-close="">CANCEL</a>
            <a href="#" class="e-button e-button--anchor e-button--blue e-button" data-payment-confirm-removal data-modal-close="">CONFIRM</a>
        </div>
    </div>
</div>