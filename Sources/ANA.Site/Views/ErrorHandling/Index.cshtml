
@using ANA.Site
@using ANA.Site.Business.Interfaces
@using ANA.Site.Models.Pages
@using ANA.Site.Models.ViewModels
@using EPiServer.Editor

@model ANA.Site.Models.ViewModels.ErrorViewModel

@inject IHttpContextAccessor _httpContextAccessor

@if (!ContentHelper.PageIsInEditMode() && _httpContextAccessor.HttpContext != null)
{
    _httpContextAccessor.HttpContext.Response.StatusCode = 404;
}

