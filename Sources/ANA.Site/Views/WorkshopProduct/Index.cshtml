@using ANA.Site.Business.Helpers
@using ANA.Site.Models.ViewModels
@using ANA.Site.Models.Blocks
@using EPiServer
@using EPiServer.Editor
@using ANA.Site.Business.State
@using ANA.Site.Models.CustomerAccountModels

@model ProductViewModel<ANA.Site.Models.Commerce.Products.WorkshopProduct>

@{
    Layout = "~/Views/Shared/Layouts/_ProductLayout.cshtml";

    var workshop = Model.VariantsModel.FirstOrDefault();
    var location = string.Empty;

    if (Model.CurrentPage.Location?.City != null)
    {
        location = $"{Model.CurrentPage.Location.City}, {Model.CurrentPage.Location.State}";
    }

    var presenterName = string.Empty;

    if (Model.CurrentPage.PresentedBy?.FilteredItems != null && Model.CurrentPage.PresentedBy.FilteredItems.Any())
    {
        presenterName = string.Join(", ", Model.CurrentPage.PresentedBy.FilteredItems
                                            .Select(p => (p.LoadContent() as IContent)?.Name)
                                            .Where(content => !string.IsNullOrEmpty(content))
                                            .ToArray());
    }

    string eventDate;
    var now = DateTime.Now;
    var startDate = Model.CurrentPage.StartDate.Equals(DateTime.MinValue) ? now : Model.CurrentPage.StartDate;
    var endDate = Model.CurrentPage.EndDate.Equals(DateTime.MinValue) ? startDate : Model.CurrentPage.EndDate;

    if (startDate.Equals(endDate))
    {
        eventDate = (startDate.Equals(now)) ? string.Empty : string.Format("{0:MMMM} {0:dd}, {0:yyyy}", startDate);
    }
    else
    {
        var startYear = $"{startDate:yyyy}";
        var endYear = $"{endDate:yyyy}";
        var startMonth = $"{startDate:MMMM}";
        var endMonth = $"{endDate:MMMM}";

        if (startYear.Equals(endYear))
        {
            if (startMonth.Equals(endMonth))
            {
                eventDate = $"{startMonth} {startDate:dd}-{endDate:dd}, {startYear}";
            }
            else
            {
                eventDate = $"{startMonth} {startDate:dd}-{endMonth} {endDate:dd}, {startYear}";
            }
        }
        else
        {
            eventDate = $"{startMonth} {startDate:dd}, {startYear}-{endMonth} {endDate:dd}, {endYear}";
        }
    }

    var eventTime = startDate.Equals(endDate) ? (startDate.Equals(now) ? string.Empty : startDate.ToShortTimeString()) : string.Format("{0} - {1}", startDate.ToShortTimeString(), endDate.ToShortTimeString());

    var hasSponsor = !string.IsNullOrEmpty(Model.CurrentPage.SponsorHeading) || !string.IsNullOrEmpty(Model.CurrentPage.SponsorIntroText);

    var firstVariant = Model.VariantsModel.FirstOrDefault();

    var gtmPrice = string.Empty;

    if (firstVariant != null)
    {
        gtmPrice = firstVariant.DiscountedPrice != null && firstVariant.DiscountedPrice.Value.Amount > 0.0m ? firstVariant.DiscountedPrice.ToString() : firstVariant.PlacedPrice.ToString();

        if (UserState.CurrentProfile.IsMember())
        {
            gtmPrice = firstVariant.DiscountedPrice != null && firstVariant.DiscountedMemberPrice.Value.Amount > 0.0m ? firstVariant.DiscountedMemberPrice.ToString() : firstVariant.MemberPrice.ToString();
        }
    }
    var productGroup = Model.CurrentPage.ProductGroupBlock;
}


@section ProductDetail
{
    <div class="c-product-page-detail grid"
         data-require="./src/views/product-detail-view"
         data-product=""
         data-product-item_name="@(firstVariant?.DisplayName ?? string.Empty)"
         data-product-item_id="@(firstVariant?.Code ?? string.Empty)"
         data-product-price="@gtmPrice"
         data-product-item_brand="@Model.BannerText"
         data-product-item_category="@Model.CurrentPage.GetOriginalType().Name.Replace("Product", string.Empty)"
         data-product-item_variant="@(firstVariant?.Code ?? string.Empty)"
         data-product-format="@(firstVariant?.VariantType ?? string.Empty)">

        <div class="grid__item one-whole medium--eight-twelfths push--medium--four-twelfths">

            <div class="grid">
                @if (string.IsNullOrEmpty(presenterName))
                {
                    <h1 class="grid__item one-whole c-product-page-detail__title">@Html.PropertyFor(x => x.CurrentPage.Heading)</h1>
                }
                else
                {
                    <h1 class="grid__item one-whole c-product-page-detail__title c-product-page-detail__title--has-subtitle">@Html.PropertyFor(x => x.CurrentPage.Heading)</h1>
                    <p class="grid__item one-whole c-product-page-detail__subtitle">@presenterName</p>
                }

                <div class="grid__item one-whole c-product-page-detail__section">

                    <div class="grid">

                        @if (workshop != null)
                        {
                            <div class="grid__item one-whole @(hasSponsor ? "large--three-eighths" : "large--one-half")">
                                @{ await Html.RenderPartialAsync("_ProductPrice", workshop); }
                            </div>
                        }

                        <div class="grid__item one-whole @(hasSponsor ? "large--two-eighths" : "large--one-half")">
                            <div class="c-product-page-detail__event">
                                @if (!string.IsNullOrEmpty(eventDate))
                                {
                                    <span class="c-product-page-detail__event-detail"><strong>Event Date:</strong> @eventDate</span>
                                }
                                @if (!string.IsNullOrEmpty(eventTime))
                                {
                                    <span class="c-product-page-detail__event-detail"><strong>Event Time:</strong> @eventTime</span>
                                }
                                @if (!string.IsNullOrEmpty(location))
                                {
                                    <span class="c-product-page-detail__event-detail">@location</span>
                                }
                                @if (!Model.CurrentPage.CEExpiry.Equals(DateTime.MinValue))
                                {
                                    <span class="c-product-page-detail__event-detail"><strong>Course & ANCC CNE Credit Expiration:</strong> @Model.CurrentPage.CEExpiry.ToString("MM/dd/yyyy")</span>
                                }
                            </div>
                        </div>

                        @if (hasSponsor)
                        {
                            <div class="grid__item one-whole large--three-eighths">

                                @{ await Html.RenderPartialAsync("_ProductAffiliate", new ProductAffiliateViewModel
                                   {
                                       SponsorImageUrl = Model.CurrentPage.SponsorImageUrl,
                                       Heading = Model.CurrentPage.Heading,
                                       SponsorHeading = Model.CurrentPage.SponsorHeading,
                                       SponsorUrl = Model.CurrentPage.SponsorUrl,
                                       SponsorIntroText = Model.CurrentPage.SponsorIntroText,
                                       SponsorLogoWide = Model.CurrentPage.SponsorLogoWide
                                   });
                                }

                            </div>
                        }
                    </div>

                </div>

                <div class="grid__item one-whole medium--one-half pull--medium--one-half c-product-page-detail__media">

                    <div class="c-product-page-detail__totalhours" @Html.Raw(productGroup != null && string.IsNullOrEmpty(firstVariant.ImageUrl) ? $"style=\"background-color: {productGroup.Colour}\"" : string.Empty)>
                        <span class="c-product-page-detail__totalhours-workshop icon--icon-workshop-alt"></span>
                        <span class="c-product-page-detail__totalhours-description">
                            <span class="c-product-page-detail__totalhours-clock icon--icon-contacthours"></span> <strong>@Model.CurrentPage.ContactHour</strong> @Html.Translate("/productpartial/contacthours")
                        </span>

                        @if (!string.IsNullOrEmpty(Model.BannerText))
                        {
                            <div class="c-product-detail__entity-banner c-product-detail__entity-banner--@Model.BannerText.ToLower()">
                                <span class="c-product-detail__entity-banner-pretext">Presented by</span>
                                <span class="c-product-detail__entity-banner-text">@Model.BannerText</span>
                            </div>
                        }
                    </div>
                    @if (productGroup != null)
                    {
                        <div class="c-product-detail__group-name c-product-detail__group-name--noline" style="color: @productGroup.Colour;">
                            @productGroup.Name
                        </div>
                    }
                </div>

                @if (Model.CurrentPage.IntroText != null && Model.CurrentPage.IntroText.Fragments.Count > 0
                     || ContentHelper.PageIsInEditMode())
                {
                    <div class="grid__item one-whole c-product-page-detail__section">
                        <div class="c-product-page-detail__description">
                            <div class="e-richtext">
                                @Html.PropertyFor(x => x.CurrentPage.IntroText)
                            </div>
                        </div>
                    </div>
                }

                @if (workshop != null)
                {
                    <div class="grid__item one-whole">
                        @{ await Html.RenderPartialAsync("_ProductCart", workshop, new ViewDataDictionary(ViewData)
                           {
                               new KeyValuePair<string, object>("GridDropdownClass", "grid__item one-whole large--one-half"),
                               new KeyValuePair<string, object>("GridQuantityAddToCartClass", "grid__item one-whole large--one-half")
                           });
                        }
                    </div>
                }

            </div>

        </div>

        @{
            var settings = ANA.Site.Business.Helpers.SettingsHelper.GetSettings();
            ContentArea contentModel = null;

            contentModel = settings?.Workshops;

            if (contentModel?.FilteredItems != null && contentModel.FilteredItems.Any())
            {
                foreach (var item in contentModel.FilteredItems.Select(x => x.LoadContent() as PromoAlertBlock))
                {
                    { await Html.RenderPartialAsync("_PromoAlertBlock", item); }
                }
            }
        }

    </div>
}



@section Adverts
{
    @Html.PropertyFor(x => x.CurrentPage.Adverts, new { CssClass = "content-area" })
}

@section Tabs
{
    <div class="c-tab-control">

        <div class="c-tab-control__section" data-require="./src/views/tab-control-view" data-collapse-panel="false">

            <h2 class="e-tab-toggle" data-tab-control-toggle>
                <span class="e-tab-toggle__text">Course details</span>
            </h2>

            <div class="c-tab-control__content" data-tab-control-content>

                <div class="e-product-detail grid">

                    @if (hasSponsor)
                    {
                        <div class="e-product-detail__sidebar grid__item one-whole large--three-twelfths">

                            <div class="e-affiliate @(Model.CurrentPage.SponsorLogoWide ? "e-affiliate--stacked" : "")">
                                @if (!string.IsNullOrEmpty(Model.CurrentPage.SponsorImageUrl))
                                {
                                    <img src="@(Model.CurrentPage.SponsorImageUrl + (Model.CurrentPage.SponsorLogoWide ? "?h" : "?w") + "=50")" alt="@Model.CurrentPage.Heading" class="e-affiliate__thumbnail" />
                                }
                                <p class="e-affiliate__text">
                                    <span class="e-affiliate__title">@Html.PropertyFor(x => x.CurrentPage.SponsorHeading)</span>
                                    @using (Html.BeginConditionalLink(!string.IsNullOrEmpty(Model.CurrentPage.SponsorUrl) && Model.CurrentPage.SponsorUrl != "#", new HtmlString(Model.CurrentPage.SponsorUrl), Model.CurrentPage.SponsorIntroText, "e-affiliate__link", null, "_blank"))
                                    {
                                        <span class="e-affiliate__link-text">@Model.CurrentPage.SponsorIntroText</span>
                                        if (!string.IsNullOrEmpty(Model.CurrentPage.SponsorUrl) && Model.CurrentPage.SponsorUrl != "#")
                                        {
                                            <span class="icon--icon-external-link"></span>
                                        }
                                    }

                                </p>
                            </div>

                        </div>
                    }

                    @if (Model.CurrentPage.Overview != null && !Model.CurrentPage.Overview.IsEmpty || ContentHelper.PageIsInEditMode())
                    {
                        <div class="grid__item one-whole large--two-thirds pad--large--one-third e-product-detail__row">
                            <div class="e-richtext">
                                @Html.PropertyFor(x => x.CurrentPage.Overview)
                            </div>
                        </div>
                    }

                    @if (Model.CurrentPage.LearningOutcomes != null && !Model.CurrentPage.LearningOutcomes.IsEmpty)
                    {
                        <div class="grid__item one-whole large--two-thirds pad--large--one-third e-product-detail__row e-product-detail__row--border">
                            @Html.PropertyFor(x => x.CurrentPage.LearningOutcomes)
                        </div>
                    }

                    @if (Model.CurrentPage.PresentedBy != null && Model.CurrentPage.PresentedBy.FilteredItems != null && Model.CurrentPage.PresentedBy.FilteredItems.Any())
                    {
                        <div class="grid__item one-whole large--two-thirds pad--large--one-third e-product-detail__row">
                            <h3 class="t-type-h4">Presented by</h3>
                        </div>
                            <div class="content-area content-area--last-child-no-margin">
                                @foreach (var presenter in Model.CurrentPage.PresentedBy.FilteredItems.Select(x => x.LoadContent() as PersonBlock))
                                {
                                    {
                                        if (presenter != null)
                                        {
                                            await Html.RenderPartialAsync("Blocks/PersonBlockAbout", new PersonBlock
                                            {
                                                Name = presenter.Name,
                                                JobTitle = presenter.JobTitle,
                                                Qualifications = presenter.Qualifications,
                                                Biography = presenter.Biography,
                                                BackgroundImage = presenter.BackgroundImage
                                            }, new ViewDataDictionary(ViewData) { new KeyValuePair<string, object>("additionalClass", "block") });
                                        }
                                    }
                                }
                            </div>
                            <div class="grid__item one-whole large--two-thirds pad--large--one-third e-product-detail__row e-product-detail__row--border"></div>
                    }





                    @if (Model.CurrentPage.RelatedVideo?.VideoUrl != null)
                    {
                        <div class="grid__item one-whole large--two-thirds pad--large--one-third e-product-detail__row e-product-detail__row--border">
                            @Html.PropertyFor(x => x.CurrentPage.RelatedVideo, new { DisableGrid = true })
                        </div>
                    }
                    @if (workshop != null)
                    {
                        <div class="grid__item one-whole large--two-thirds pad--large--one-third e-product-detail__row e-product-detail__row--border">
                            @{
                                await Html.RenderPartialAsync("_ProductCart", workshop, new ViewDataDictionary(ViewData)
                                        {
                                        new KeyValuePair<string, object>("ModifierClass", "c-add-to-cart--single-line-at-medium")
                                        });
                            }
                        </div>
                    }
                    @if (Model.CurrentPage.CourseBlocks != null && !Model.CurrentPage.CourseBlocks.IsEmpty || ContentHelper.PageIsInEditMode())
                    {
                        <div class="grid__item one-whole e-product-detail__row">
                            @Html.PropertyFor(x => x.CurrentPage.CourseBlocks, new
                       {
                           CssClass = "content-area content-area--last-child-no-margin b-vst--small grid",
                           Tag = ANA.Site.Global.ContentAreaTags.LeftHandNav + ANA.Site.Global.StringConstants.TagSeparator +
                                ANA.Site.Global.ContentAreaTags.Grid + ANA.Site.Global.StringConstants.TagSeparator
                       })
                        </div>
                    }
                </div>

            </div>

        </div>

        <div class="c-tab-control__section" data-require="./src/views/tab-control-view" data-collapse-panel="true">

            <h2 class="e-tab-toggle" data-tab-control-toggle>
                <span class="e-tab-toggle__text">Location details</span>
            </h2>

            <div class="c-tab-control__content" data-tab-control-content>

                @if (Model.CurrentPage.EventDetails != null &&
        !Model.CurrentPage.EventDetails.IsEmpty || ContentHelper.PageIsInEditMode())
                {
                    <div class="e-product-detail grid">
                        <div class="grid__item one-whole large--two-thirds pad--large--one-third e-product-detail__row">
                            <div class="e-richtext">
                                @Html.PropertyFor(x => x.CurrentPage.EventDetails)
                            </div>
                        </div>

                    </div>
                }

                <div class="e-product-detail grid">
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentPage.Location.GetLocationString()))
                    {
                        <div class="grid__item one-whole large--two-thirds pad--large--one-third e-product-detail__row e-product-detail__row--border">
                            <h3 class="t-type-h4">Location and Details</h3>
                            <a href="https://www.google.com/maps/search/@(WebUtility.UrlEncode(Model.CurrentPage.Location.GetLocationString()))" target="_blank">
                                <img src="https://maps.googleapis.com/maps/api/staticmap?center=@(WebUtility.UrlEncode(Model.CurrentPage.Location.GetLocationString()))&zoom=15&size=750x400&maptype=roadmap&markers=color:red%7Clabel:1%7C@(WebUtility.UrlEncode(Model.CurrentPage.Location.GetLocationString()))@(string.IsNullOrEmpty(SettingsHelper.GetSettings().GoogleMapsApiKey) ? string.Empty : "&key=" + SettingsHelper.GetSettings().GoogleMapsApiKey)" />
                            </a>
                        </div>
                    }

                    <div class="grid__item one-whole large--one-third pad--large--one-third">
                        <h4>Address</h4>
                        @Html.PropertyFor(x => x.CurrentPage.Location)
                    </div>
                    <div class="grid__item one-whole large--one-third">
                        <h4>Details</h4>
                        <div class="c-product-page-detail__event">
                            <span class="c-product-page-detail__event-detail">@eventDate</span>
                            <span class="c-product-page-detail__event-detail">@(startDate.Equals(endDate) ? (startDate.Equals(now) ? string.Empty : startDate.ToShortTimeString()) : string.Format("{0} - {1}", startDate.ToShortTimeString(), endDate.ToShortTimeString()))</span>
                        </div>
                    </div>
                    <div class="grid__item one-whole large--two-thirds pad--large--one-third e-product-detail__row e-product-detail__row--border"></div>
                </div>


                @Html.PropertyFor(x => x.CurrentPage.EventBlocks, new
           {
               CssClass = "content-area content-area--last-child-no-margin b-vst--small grid",
               Tag = ANA.Site.Global.ContentAreaTags.LeftHandNav + ANA.Site.Global.StringConstants.TagSeparator +
                                ANA.Site.Global.ContentAreaTags.Grid + ANA.Site.Global.StringConstants.TagSeparator
           })

            </div>

        </div>
    </div>
}

@section ContentArea
{
    @Html.PropertyFor(x => x.CurrentPage.Blocks, new { CssClass = "content-area", Tag = ANA.Site.Global.StringConstants.TagProduct })

    @{ await Html.RenderPartialAsync("_RelatedProducts", new RelatedProductsViewModel
       {
           Heading = Html.Translate("/BookPage/Related").ToString(),
           RelatedProducts = Model.RelatedProducts.Select(p => new ProductPartialViewModel
           {
               Product = p.Product,
               VariantsModel = new List<VariantsViewModel> { p },
               BannerText = p.Product.EntityBanner
           }).ToList()
       });
    }
}

}