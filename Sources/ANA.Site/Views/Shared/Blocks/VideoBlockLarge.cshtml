@using ANA.Site
@using ANA.Site.Business.Helpers
@using Geta.Optimizely.Extensions;
@model ANA.Site.Models.Blocks.VideoBlock

@{
    var videoId = Model.VideoUrl == null ? "0" : Model.VideoUrl.ToString().Replace("https://www.youtube.com/watch?v=", string.Empty).Replace("https://youtu.be/", string.Empty).Split('&').FirstOrDefault().Split('?').FirstOrDefault();
    var youtubeImageFormat = "https://img.youtube.com/vi/{0}/maxresdefault.jpg";
    var previewImage = Model.PreviewImage == null ? string.Format(youtubeImageFormat, videoId) : Model.PreviewImage.GetFriendlyUrl();

    var tag = (Html.ViewData[ANA.Site.Global.StringConstants.Tag] as string) ?? string.Empty;

    var gridClass = tag.Contains(ANA.Site.Global.ContentAreaTags.LeftHandNav + ANA.Site.Global.StringConstants.TagSeparator)
        ? " " + ANA.Site.Global.StringConstants.GridClass10ColRight
        : " " + ANA.Site.Global.StringConstants.GridClass10ColCentre;

    var responsiveImageString = string.Empty;
    var att = "data-responsive-background-";
    if (Model.PreviewImage != null)
    {
        responsiveImageString = $"{att}image {att}xsmall=\"{Model.PreviewImage.GetCroppedImageUrl(422, 378)}\" {att}small=\"{Model.PreviewImage.GetCroppedImageUrl(710, 400)}\" {att}medium=\"{Model.PreviewImage.GetCroppedImageUrl(855, 498)}\" {att}large=\"{Model.PreviewImage.GetCroppedImageUrl(748, 421)}\" {att}xlarge=\"{Model.PreviewImage.GetCroppedImageUrl(867, 487)}\"";
    }

}

<section class="c-media-block c-media-block--inline" data-require="./src/views/video-view">

    <div class="grid-constraint">

        <div class="grid">
            <div class="grid__item @gridClass">
                <div class="grid">

                    <div class="grid__item one-whole large--eight-tenths">
                        <a href="@Model.VideoUrl" style="background-image: url('@previewImage');" class="c-media-block__link" title="Play video @Model.CaptionTitle" data-video-link @responsiveImageString>
                            <span class="c-media-block__play-icon" data-video-play-icon></span>
                        </a>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.CaptionTitle))
                    {
                        <div class="c-media-block__caption grid__item one-whole large--two-tenths">
                            <div class="c-media-block__caption-content">
                                <h2 class="c-media-block__heading">@Model.CaptionTitle</h2>
                                <p class="c-media-block__description">@Model.Caption</p>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>
</section>
