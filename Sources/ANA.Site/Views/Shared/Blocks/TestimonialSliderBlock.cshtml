@using ANA.Site
@using ANA.Site.Business.Helpers
@model ANA.Site.Models.Blocks.TestimonialSliderBlock

<div class="grid-constraint">
    <div class="grid grid--full">
        <div class="grid__item one-whole">
            <section class="c-testimonial-slider">
                <h2 class="section-title">@Model.SectionTitle</h2>
                <div class="carousel owl-carousel" data-require="./src/views/testimony-slider-view">
                    @if (Model.TestimonialBlocks != null && Model.TestimonialBlocks.Items != null && Model.TestimonialBlocks.Items.Count > 0)
                    {
                        foreach (var item in Model.TestimonialBlocks.FilteredItems)
                        {
                            var contentItem = item.LoadContent() as ANA.Site.Models.Blocks.TestimonialBlock;

                            await Html.RenderPartialAsync("Blocks/TestimonialBlock", contentItem);
                        }
                    }
                </div>
            </section>
        </div>
    </div>
</div>
