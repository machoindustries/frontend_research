@using ANA.Site.Business.Extensions
@using ANA.Site.Business.Helpers
@model ANA.Site.Models.Blocks.JoinPromoBlock

@if (Model != null)
{
    <div class="c-join-promo-home">
        @if (Model.Heading != null)
        {
            <h3 class="title">@Model.Heading</h3>
        }

        @if (Model.CTALink != null && Model.CTATitle != null)
        {
            <a href="@Model.CTALink" class="e-button e-button--orange">@Model.CTATitle</a>
        }
    </div>
}

