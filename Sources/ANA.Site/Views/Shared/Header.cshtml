@using System.Configuration
@using System.Web
@using ANA.Site.Business.Extensions
@using ANA.Site.Business.State
@using ANA.Site.Settings
@using EPiServer.Cms.Shell
@using EPiServer.Data.Cache
@using Geta.Optimizely.Extensions;
@using Geta.Net.Extensions
@model ANA.Site.Models.ViewModels.IPageViewModel<ANA.Site.Business.Interfaces.ICommonProperties>
@inject IAppSettings _appSettings

<a href="#content" class="c-header__skip-to-content sr-only">Skip to content</a>

<header class="c-header">

    @if (Model.Layout.BusinessNavigation != null)
    {
        <a href="#content" class="c-header__skip-to-content sr-only">Skip to content</a>
        <div class="c-header__wrap">
            @if (!Model.Layout.IsHeaderSimpleVersion)
            {
                <div class="c-header__grid">
                    <div class="c-header__grid-item c-header__nav-container c-header__nav-container--global">
                        <div class="e-global-nav grid grid--full" data-require="./src/views/global-nav-view">
                            <div class="e-global-nav__content-constraint">
                                <div class="grid">
                                    <div class="e-global-nav__col grid__item one-whole xlarge--three-fifths">
                                        <nav class="e-entities-nav">
                                            <ul class="e-entities-nav__list">
                                                @foreach (var link in Model.Layout.BusinessNavigation)
                                                {
                                                    <li class="e-entities-nav__item">
                                                        <a href="@(new EPiServer.Url(link.Href).GetFriendlyUrl())" class="e-entities-nav__link" title="@link.Text" target="@link.Target" data-global-nav-link data-gtm-event-label="@link.Text">@link.Text</a>
                                                    </li>
                                                }
                                            </ul>
                                        </nav>
                                    </div>
                                    <div class="e-global-nav__col e-global-nav__col--tools grid__item one-whole xlarge--two-fifths">
                                        <nav class="e-header-tools e-header-tools--desktop" data-require="./src/views/header-tools-view">
                                            <ul class="e-header-tools__list">
                                                <li class="e-header-tools__item">
                                                    <a class="e-header-tools__link e-header-tools__link--collapse e-header-tools__link--cart" href="@Model.Layout.SettingsPage.CartPageReference.GetUri().ToString()" title="@Model.Layout.CartItemCount" data-require="./src/views/mini-cart-view" data-header-tools-cta data-gtm-event-label="@Html.Translate("/header/cart")">
                                                        <span class="e-header-tools__cart-item-count" data-cart data-mini-cart-item-count>@Model.Layout.CartItemCount</span>
                                                        <span class="sr-only">@Html.Translate("/header/cart")</span>
                                                    </a>
                                                </li>
                                                @if (Model.Layout.SettingsPage.AccountPageReference != null && User.Identity.IsAuthenticated)
                                                {
                                                    <li class="e-header-tools__item e-header-tools__item--account">
                                                        <a class="e-header-tools__link e-header-tools__link--account"
                                                           href="@Model.Layout.SettingsPage.AccountPageReference.GetUri().ToString()"
                                                           title="@Html.Translate("/header/myaccount")" data-header-tools-cta>
                                                            <span class="e-header-tools__link-label">@Html.Translate("/header/myaccount")</span>
                                                        </a>
                                                    </li>
                                                }
                                                @if (User.Identity.IsAuthenticated)
                                                {
                                                    var logOutUrl = $"/Logout?returnurl={HttpUtility.UrlEncode(Model.CurrentPage.ContentLink.GetFriendlyUrl(true, true) + "?act=logout")}";
                                                    <li class="e-header-tools__item e-header-tools__item--account">
                                                        <a class="e-header-tools__link e-header-tools__link--account"
                                                           href="@logOutUrl"
                                                           title="@Html.Translate("/header/logout") (@UserState.CurrentProfile.Email)" data-header-tools-cta>
                                                            <span class="e-header-tools__link-label">@Html.Translate("/header/logout")</span>
                                                        </a>
                                                    </li>
                                                }
                                                else
                                                {
                                                    // Use a local controller action that stores the return URL in session and redirects to SSO.
                                                    var loginUrl = Url.Action("LoginRedirect", "Account", new { returnUrl = Model.CurrentPage.ContentLink.GetFriendlyUrl(true, true) });
                                                    <li class="e-header-tools__item e-header-tools__item--account">
                                                        <a class="e-header-tools__link e-header-tools__link--account"
                                                           href="@loginUrl"
                                                           title="@Html.Translate("/header/login")" data-header-tools-cta>
                                                            <span class="e-header-tools__link-label">@Html.Translate("/header/login")</span>
                                                        </a>
                                                    </li>
                                                }
                                                @if (!Model.Layout.CtaText.IsNullOrEmpty() && Model.Layout.CtaUrl != null)
                                                {
                                                    <li class="e-header-tools__item e-header-tools__item--cta">
                                                        <a class="e-header-tools__link e-header-tools__link--cta" href="@Url.ContentUrl(Model.Layout.CtaUrl)" target="@Model.Layout.CtaTarget" title="@Model.Layout.CtaText" data-header-tools-cta>
                                                            <span class="e-header-tools__link-label">@Model.Layout.CtaText</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (!(Model.CurrentPage is ANA.Site.Hub.Models.Pages.IHubPage))
            {
                @await Html.PartialAsync("Navigation", Model)
            }
        </div>
    }

</header>