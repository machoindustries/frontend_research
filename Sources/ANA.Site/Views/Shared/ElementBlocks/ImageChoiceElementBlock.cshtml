@using EPiServer.Editor
@using EPiServer.Forms.Helpers.Internal
@using EPiServer.Forms.Implementation.Elements
@using ANA.Site.Business.Extensions
@using EPiServer.ServiceLocation

@model ImageChoiceElementBlock

@{
    var formElement = Model.FormElement;
    var labelText = Model.Label;
    var urlResolver = ServiceLocator.Current.GetInstance<UrlResolver>();
    var sShouldBeVisible = Model.ShowSelectionInputControl ? "" : "hidden";

    var submittedValue = Model.GetSubmittedValue() as string;
    string[] entries = null;

    if (!string.IsNullOrWhiteSpace(submittedValue))
    {
        entries = submittedValue.Split(',');    
    }
}

@if (Model.Items.Any() || ContentHelper.PageIsInEditMode())
{

    <div class="@Model.GetGridCssClass()">

        <div class="Form__Element FormChoice FormChoice--Image @Model.GetValidationCssClasses()" id="@formElement.Guid" data-epiforms-element-name="@formElement.ElementName" @Model.AttributesString>
        
            <div class="Form__Element__Caption">@(string.IsNullOrWhiteSpace(labelText) ? "" : labelText)</div>

            @{
                var index = 0;

                foreach (var item in Model.Items)
                {
                    var imageChoiceId = string.Format("{0}_{1}", formElement.Guid, index);

                    var defaultCheckedString = Model.GetDefaultSelectedString(item);
                    var checkedString = string.IsNullOrEmpty(defaultCheckedString) ? string.Empty : "checked";

                    if (!string.IsNullOrWhiteSpace(submittedValue))
                    {
                        defaultCheckedString = "";

                        if (entries != null)
                        {
                            checkedString = entries.Any(s => s == item.Text) ? "checked" : "";
                        }
                        else
                        {
                            checkedString = submittedValue == item.Text ? "checked" : "";
                        }
                    }

                    <label class="FormChoice--Image__Item">
                        <img class="FormChoice--Image__Item-Image" src="@urlResolver.GetUrl(item.GetMappedHref())" title="@(item.Title ?? item.Text)" />
                        <span class="FormChoice--Image__Item-Input-Text">
                            @if (Model.AllowMultiSelect)
                            {
                                <input type="checkbox" id="@imageChoiceId" name="@formElement.ElementName" value="@item.Text" @checkedString @defaultCheckedString class="FormChoice__Input FormChoice__Input--Checkbox @sShouldBeVisible" />
                            }
                            else
                            {
                                <input type="radio" id="@imageChoiceId" name="@formElement.ElementName" value="@item.Text" @checkedString @defaultCheckedString class="FormChoice__Input FormChoice__Input--Radio @sShouldBeVisible" />
                            }
                            <span class="FormChoice--Image__Item__Caption">@item.Text</span>
                        </span>
                    </label>

                    index++;
                }
            }
        
            <span data-epiforms-linked-name="@formElement.ElementName" class="Form__Element__ValidationError" style="display: none;">@Model.GetGenericErrorMessage()</span>
        </div>

    </div>
}