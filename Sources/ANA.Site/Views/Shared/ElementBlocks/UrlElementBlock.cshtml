@using ANA.Site
@using EPiServer.Forms.Implementation.Elements
@using ANA.Site.Business.Extensions

@model UrlElementBlock

@{
    var formElement = Model.FormElement;
    var labelText = Model.Label;
    var helpText = Model.GetHelpText();
    var context = ServiceLocator.Current.GetInstance<IHttpContextAccessor>();

}

<label for="@formElement.Guid" class="e-form__label e-form__label--text" data-formfield>
	<span class="e-form__label-text" data-fake-placeholder>@labelText</span>
    <input type="text" name="@formElement.ElementName" class="e-form__input e-form__input--text @(Model.HasError() ? ANA.Site.Global.StringConstants.FormsValidationFailCssClass : "")" title="@labelText" value="@(String.IsNullOrEmpty(context.HttpContext?.Request.Form[Model.Content.Name]) ? Model.GetSubmittedOrDefaultValue() : context.HttpContext?.Request.Form[Model.Content.Name])" @Html @Html.Raw(Model.AttributesString) data-formfield-text @Model.GetValidationAttributes()>
</label>
@if (!string.IsNullOrWhiteSpace(helpText))
{
    <p class="Form__HelpText">@helpText</p>
}
@Model.RenderDataList()
<div class="e-form__validation-errors" data-validation-error data-validation-for="@formElement.ElementName">@Model.GetGenericErrorMessage()</div>
