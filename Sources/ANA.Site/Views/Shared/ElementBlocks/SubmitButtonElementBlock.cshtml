@using EPiServer.Forms.Implementation.Elements
@inject IHttpContextAccessor _httpContextAccessor
@model SubmitButtonElementBlock

@{
    var formElement = Model.FormElement;
    var buttonText = Model.Label;
    var buttonDisableState = Model.GetFormSubmittableStatus(_httpContextAccessor.HttpContext);
}

<input id="@formElement.Guid" class="e-button e-button--submit e-button--blue e-form__submit" type="submit" value="@buttonText" @Html.Raw(Model.AttributesString) />
