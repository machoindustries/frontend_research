@using EPiServer.Forms.Helpers.Internal
@using EPiServer.Forms.Implementation.Elements
@using ANA.Site
@using ANA.Site.Business.Extensions

@model SelectionElementBlock

@{
    var formElement = Model.FormElement;
    var labelText = Model.Label;
    var placeholderText = Model.PlaceHolder;
    var defaultOptionItemText = !string.IsNullOrWhiteSpace(placeholderText) ? placeholderText : Html.Translate(string.Format("/episerver/forms/viewmode/selection/{0}", Model.AllowMultiSelect ? "selectoptions" : "selectanoption")).ToString();
    var defaultOptionSelected = Model.Items.Count(x => x.Checked.HasValue && x.Checked.Value) <= 0 ? "selected=\"selected\"" : "";
    var items = Model.GetItems();
    var helpText = Model.GetHelpText();
    var submittedValue = Model.GetSubmittedValue() as string;

    string[] entries = null;

    if (!string.IsNullOrWhiteSpace(submittedValue))
    {
        entries = submittedValue.Split(',');
    }
}

<div class="@Model.GetGridCssClass() medium--one-half">

    <div class="Form__Element FormSelection @Model.GetValidationCssClasses() @(Model.HasError() ? ANA.Site.Global.StringConstants.FormsValidationFailCssClass : "")" data-epiforms-element-name="@formElement.ElementName">
        <label for="@formElement.Guid" class="Form__Element__Caption">@labelText</label>
        <select class="FormSelection__Input" name="@formElement.ElementName" id="@formElement.Guid" @(Model.AllowMultiSelect ? "multiple" : "") @Model.AttributesString>
            <!option disabled="disabled" @defaultOptionSelected value="">@defaultOptionItemText</!option>

            @foreach (var item in items)
            {
                var defaultSelectedString = Model.GetDefaultSelectedString(item);
                var selectedString = string.IsNullOrEmpty(defaultSelectedString) ? string.Empty : "selected";

                if (!string.IsNullOrWhiteSpace(submittedValue))
                {
                    defaultSelectedString = "";

                    if (entries != null)
                    {
                        selectedString = entries.Any(s => s == item.Value) ? "selected" : "";
                    }
                    else
                    {
                        selectedString = item.Value == submittedValue ? "selected" : "";
                    }
                }
                <!option value="@item.Value" @selectedString @defaultSelectedString>@item.Caption</!option>
            }
        </select>
        <span data-epiforms-linked-name="@formElement.ElementName" class="Form__Element__ValidationError" style="display: none;">@Model.GetGenericErrorMessage()</span>
    </div>

</div>

@if (!string.IsNullOrWhiteSpace(helpText))
{
    <div class="@Model.GetGridCssClass() medium--one-half">
        <p class="Form__HelpText Form__HelpText--half">@helpText</p>
    </div>
}