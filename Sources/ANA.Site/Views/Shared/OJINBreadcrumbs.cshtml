@model ANA.Site.Models.ViewModels.Ojin.IOJINPageViewModel<ANA.Site.Business.OJIN.OJINInterfaces.IOJINCommonProperties>

<section class="ojin-breadcrumb">
    <div class="container">
        <ol class="breadcrumb">
            @*From the Front End code*@
            @*<li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item"><a href="#">Table Of Contents</a></li>
            <li class="breadcrumb-item"><a href="#">Vol 25 2020</a></li>
            <li class="breadcrumb-item active" aria-current="page">No3 Sept 2020</li>*@
            @foreach (var itm in Model.Layout.Breadcrumbs)
                        {
                            if (!itm.IsCurrentPage)
                            {
                                <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem" data-breadcrumb-list-item>
                                    <a href="@itm.LinkUrl" itemprop="item" title="@itm.LinkText">
                                        <span itemprop="name">@itm.LinkText</span>
                                    </a>
                                    <meta itemprop="position" content="@itm.Index" />
                                </li>
                            }
                            else
                            {
                                <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem" data-breadcrumb-list-item>
                                    <span itemprop="item" title="@itm.LinkText">
                                        <span itemprop="name">@itm.LinkText</span>
                                    </span>
                                    <meta itemprop="position" content="@itm.Index" />
                                </li>
                            }
                        }
        </ol>
    </div>
</section>

