@using ANA.Site
@using ANA.Site.Business.Helpers
@using ANA.Site.Models.Media
@using EPiServer.Editor
@using Geta.Optimizely.Extensions;
@using EPiServer.Web.Mvc.Html
@model ANA.Site.Models.ViewModels.Ojin.OJINPageViewModel<ANA.Site.Models.OJIN.Pages.OJINTopicCategoryListingPage>

@{
    Layout = "~/Views/Shared/Layouts/_OJINBase1.cshtml";
}

<div>
    <section class="ojin-introText pb-4">
        <div class="row">
            <div class="col-lg-9">
                @Html.PropertyFor(m => m.CurrentPage.Title)
                @Html.PropertyFor(m => m.CurrentPage.IntroText)
            </div>
        </div>
    </section>
    <section class="pt-3 pt-md-4 mt-5">
        <div class="row">
            <div class="col-lg-9">
                <div class="ojin-columns">
                </div>
            </div>
            @if (Model.RightRail != null)
            {
                <div class="col-lg-3 ojin-advContainer">
                    @{ await Html.RenderPartialAsync("Blocks/OJINTopicCategoryListingPageRightRail", Model.RightRail); }
                </div>
            }

        </div>
    </section>
</div>
