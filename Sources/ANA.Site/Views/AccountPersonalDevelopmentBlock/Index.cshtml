@using EPiServer.Editor
@using ANA.Site.Business.State
@using ANA.Site.Models.CustomerAccountModels
@using System.Data
@using ANA.Site.Business.Helpers

@model ANA.Site.Models.ViewModels.AccountPersonalDevelopmentViewModel
@{
    var settings = SettingsHelper.GetSettings();
    var ExplanatoryText = string.IsNullOrEmpty(settings.DownloadAllCERecExplanatoryText) ? "" : settings.DownloadAllCERecExplanatoryText;
}

<div class="c-account__section">
    <div data-require="./src/views/account-continuing-education-view">
