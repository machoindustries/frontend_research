<script>

    const fromYearSelect = document.getElementById('fromYear');
    const toYearSelect = document.getElementById('toYear');
    const yearHiddenFrom  = document.getElementById('yearHiddenFrom ');
    const hiddenToYear = document.getElementById('hiddenToYear');
    const statusSelect = document.getElementById('status');
    const hiddenStatus = document.getElementById('hiddenStatus');

    document.addEventListener('DOMContentLoaded', function () {

        fromYearSelect.addEventListener('change', function () {
        const selectedValueFrom = fromYearSelect.value;
        yearHiddenFrom .value = selectedValueFrom;
        });

        toYearSelect.addEventListener('change', function () {
        const selectedValueTo = toYearSelect.value;
        hiddenToYear.value = selectedValueTo;
        });

        statusSelect.addEventListener('change', function () {
        const selectedValueStatus = statusSelect.value;
        hiddenStatus.value = selectedValueStatus;
        });
    });
    function resetFields() {
    fromYearSelect.selectedIndex = 0;
    toYearSelect.selectedIndex = 0;
    statusSelect.selectedIndex = 1;
    yearHiddenFrom .value = '';
    hiddenToYear.value = '';
    hiddenStatus.value = 'Restored';
    }
</script>
<div hidden>
    <div data-lightbox-src="archiveRecord">
        <h3>
            Confirm
        </h3>
        <p>
            Are you sure want to archive the record?
        </p>
        <a href="#" class="e-button e-button--anchor e-button--blue e-button" data-confirm-archive-yes>Yes</a>
        <a href="#" class="e-button e-button--anchor e-button--blue e-button" data-cancel-remove data-modal-close>No</a>

    </div>

    <div data-lightbox-src="restoreRecord">
        <h3>
            Confirm
        </h3>
        <p>
            Are you sure want to restore the record?
        </p>
        <a href="#" class="e-button e-button--anchor e-button--blue e-button" data-confirm-restore-yes>Yes</a>
        <a href="#" class="e-button e-button--anchor e-button--blue e-button" data-cancel-remove data-modal-close>No</a>

    </div>
</div>