        {
            <h2 class="c-account__title">@Html.PropertyFor(m => m.EducationHeading)</h2>
        }
        @if (!string.IsNullOrWhiteSpace(Model.EducationDescription) || ContentHelper.PageIsInEditMode())
        {
            <p class="c-account__text">@Html.PropertyFor(m => m.EducationDescription)</p>
        }

        @Html.ActionLink("DOWNLOAD ALL CE RECORDS", "DownloadContinuingEducation", "AccountPersonalDevelopmentBlock", null, new Dictionary<string, object>
            { { "class", "e-button--orange" } })
        <br />
        <br />
        <div>
            <b>Total Contact Hours: <span id="TotalContactHours" data-account-continuing-education-total-contact-hours>0</span></b>
            <br /><b>Total Pharmacotherapeutics Hours: <span id="TotalPharmaHours" data-account-continuing-education-total-pharma-hours>0</span></b>
        </div>
        <div class="awards_title" data-account-continuing-education-title-self-entered>
            Self-Entered Professional Development Entries
        </div>
        @if (!string.IsNullOrEmpty(ExplanatoryText))
        {
            <br />
            <br />
            <div class="label-info">
                <span>@ExplanatoryText</span>
            </div>
        }

        <div class="c-account__summary">
            <a href="#" id="myCETop" class="c-account__cta--add-new-display" title="@Html.Translate(" /ProfessionalDevelopment/Education/New")" data-account-continuing-education-add>@Html.Translate("/ProfessionalDevelopment/Education/New")</a>
            <div style="text-align:right;float:right">
                <b>
                    Contact Hours: <span id="totalHours" data-account-continuing-education-total-hours>0</span>
                    <br /> Pharmacotherapeutics Hours: <span id="totalPharma" data-account-continuing-education-total-pharma>0</span>
                </b>
            </div>
        </div>


        <table data-account-continuing-education-table style="display: none;">
            <thead>
                <tr>
                    <th>@Html.Translate("/ProfessionalDevelopment/Education/Subject")</th>
                    <th>@Html.Translate("/ProfessionalDevelopment/Education/Description")</th>
                    <th>@Html.Translate("/ProfessionalDevelopment/Education/Sponsors")</th>
                    <th>@Html.Translate("/ProfessionalDevelopment/Education/Date")</th>
                    <th>@Html.Translate("/ProfessionalDevelopment/Education/Hours")</th>
                    <th>@Html.Translate("/ProfessionalDevelopment/Education/PharmacoHours")</th>
                    <th>@Html.Translate("/ProfessionalDevelopment/Education/Approved")</th>
                    <th>@Html.Translate("/ProfessionalDevelopment/Education/Options")</th>
                </tr>
            </thead>
            <tbody data-account-continuing-education-list=""></tbody>
        </table>
        <div class="c-account__no-results" data-account-continuing-education-no-results="">@Html.Translate("/ProfessionalDevelopment/Education/NoResults")</div><br />
        <div class="e-lightbox-source">
            @Html.EditorFor(m => m.ProfessionalEducationLightBox)
        </div>
    </div>
    <div data-require="./src/views/account-continuing-education-awards-view">
        @if (!string.IsNullOrEmpty(ExplanatoryText))
        {
            <br />
            <br />
            <div class="label-info">
                <span>@ExplanatoryText</span>
            </div>
        }
        <div>
            <div class="awards_title" data-account-continuing-education-title-auto-populated>
                Auto Populated ANA Courses Table
            </div>
            <div class="col-sm-6" style="float:left;margin-top:10px;margin-bottom:5px;" data-account-continuing-education-filter-section>
                <input type="hidden" id="yearHiddenFrom " name="yearHiddenFrom " value="0" data-account-continuing-education-from-year-fitler>
                <input type="hidden" id="hiddenToYear" name="hiddenToYear" value="0" data-account-continuing-education-to-year-fitler>
                <b>Completion Date:</b>
                From:
                <select id="fromYear" name="fromYear" class="select_no_dropdown">
                </select>&nbsp;&nbsp;
                To:
                <select id="toYear" name="toYear" class="select_no_dropdown">
                </select>&nbsp;&nbsp;
                <input type="hidden" id="hiddenStatus" name="hiddenStatus" value="Restored" data-account-continuing-education-status-fitler>
                &nbsp;&nbsp;<b>Status:</b>
                <select id="status" name="status" class="select_no_dropdown">
                    <option value="All">All</option>
                    <option value="Restored" selected>Active</option>
                    <option value="Archived">Archived</option>
                </select>
                &nbsp;&nbsp;&nbsp;
                <button class="apply-date-filter" data-account-continuing-education-apply-fitler> Apply </button>
                <button class="clear-date-filter" onclick="resetFields();" data-account-continuing-education-clear-fitler> Clear </button>
            </div>
            <div>
                <div class="col-sm-6" style="margin-bottom:-16px;text-align:right;">

                    <br /><br /><b>
                        Contact Hours: <span data-account-continuing-education-contact-hours></span>
                        <br />
                        Pharmacotherapeutics Hours: <span data-account-continuing-education-pharma-hours></span>
                    </b>
                </div>
                <br />
                <div class="col-sm-6" style="font-size: smaller; font-weight: 600;" data-account-continuing-education-awards-table-message>@Html.Translate("/ProfessionalDevelopment/awards/TableDataMessage")</div>
                <div class="col-sm-6" style="font-size: smaller; font-weight: 600;" data-account-continuing-education-awards-table-message>
                    @Html.Translate("/ProfessionalDevelopment/awards/SaveContactHoursMessage")
                <button class="save-update-records awards-button" style="margin-bottom: 1%; margin-top: 1%;" data-account-continuing-education-save-records="" data-contact-hours-modified=false> Save </button>
            </div>
        </div>
    </div>
    <table data-account-continuing-education-awards-table class="auto_populated_table" style="display: none;">
        <thead>
            <tr>
                <th class="c-account__sortable" style="width: 21%;text-align:center;">@Html.Translate("/ProfessionalDevelopment/awards/ANACourseName")<button class="sort_button" data-account-continuing-education-sortby-name> </button></th>
                <th>@Html.Translate("/ProfessionalDevelopment/awards/Provider")</th>
                <th class="c-account__sortable">@Html.Translate("/ProfessionalDevelopment/awards/CompletionDate")  <button class="sort_button" data-account-continuing-education-sortby-completion-date> </button></th>
                <th>@Html.Translate("/ProfessionalDevelopment/awards/RegularHours")</th>
                <th>
                    @Html.Translate("/ProfessionalDevelopment/awards/PharmacoHours")
                </th>
                <th>@Html.Translate("/ProfessionalDevelopment/awards/Approved")</th>
                <th>@Html.Translate("/ProfessionalDevelopment/awards/Actions")</th>
            </tr>
        </thead>
        <tbody data-account-continuing-education-list=""></tbody>
    </table>
    <div class="c-account__no-results" data-account-continuing-education-no-results="">@Html.Translate("/ProfessionalDevelopment/Education/NoResults")</div><br />
    <span>
