@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>500 - American Nurses Association</title>
    <link rel="shortcut icon" href="/assets/img/logos/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="/styles/screen" />
    <style>
        .error-fallback {
            max-width: 600px;
            margin: 80px auto;
            padding: 0 20px;
            text-align: center;
            font-family: Lato, sans-serif;
        }
        .error-fallback__code {
            font-size: 72px;
            font-weight: 900;
            color: #CB3727;
            margin: 0;
        }
        .error-fallback__heading {
            font-size: 24px;
            margin: 10px 0 20px;
        }
        .error-fallback__link {
            color: #CB3727;
        }
    </style>
</head>
<body>
    <div class="error-fallback">
        <p class="error-fallback__code">500</p>
        <h1 class="error-fallback__heading">We're experiencing a technical issue</h1>
        <p>Our team has been notified. Please try again shortly or return to the <a class="error-fallback__link" href="/">homepage</a>.</p>
    </div>
</body>
</html>
