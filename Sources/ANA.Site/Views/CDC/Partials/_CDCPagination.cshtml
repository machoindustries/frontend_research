@model ANA.Site.Models.CDC.Blocks.ViewModels.CDCPaginationViewModel

<nav class="e-pagination@(string.IsNullOrWhiteSpace(Model.AdditionalCssClass) ? "" : " " + Model.AdditionalCssClass)">
    @if (Model.PageNumber > 1 && Model.PageNumber <= Model.TotalPages)
    {
        <a href="@Model.PreviousPageUrl" class="e-pagination__dir e-pagination__dir--prev">
            <span class="sr-only">@Html.Translate("/Shared/Pagination/Previous")</span>
        </a> 
    }
    else
    {
        <span class="e-pagination__dir e-pagination__dir--disabled e-pagination__dir--prev">
            <span class="sr-only">@Html.Translate("/Shared/Pagination/Previous")</span>
        </span>
    }

    <div class="e-pagination__list">
        <span class="e-pagination__list-item">@Model.PageNumber</span> @Html.Translate("/Shared/Pagination/Of") <span class="e-pagination__list-item">@Model.TotalPages</span>
    </div>

    @if (Model.PageNumber < Model.TotalPages)
    {
        <a href="@Model.NextPageUrl" class="e-pagination__dir e-pagination__dir--next">
            <span class="sr-only">@Html.Translate("/Shared/Pagination/Next")</span>
        </a> 
    }
    else
    {
        <span class="e-pagination__dir e-pagination__dir--disabled e-pagination__dir--next">
            <span class="sr-only">@Html.Translate("/Shared/Pagination/Next")</span>
        </span>
    }
</nav>