@using Geta.Optimizely.Extensions;
@using ANA.Site.Models.CDC.Pages.ViewModels
@model CDCNewsListingPageViewModel

@{
    Layout = "~/Views/Shared/Layouts/_CDCContent.cshtml";
}

<div class="detail-header cell small-12 b700 h4 mt-3 mb-1 float-left">
    @Html.PropertyFor(i => i.CurrentPage.Heading)
</div>

<div class="vert-grad-bottom cell small-12">
    <div class="inner-grad hide=hide-for-small-only"></div>
    <div class="grid-x">
        <div class="main-left news-cards cell small-12 large-10 mt-2">
            <section id="news">
                <div class="grid-x grid-margin-x mt-1">
                    @foreach (var news in Model.News)
                    {
                        var url = news.GetFriendlyUrl();
                        var target = news.GetTargetFrame();
                        <div class="cell small-12 medium-6 large-4">
                            <article class="card-container cell small-4">
                                <div class="card homepage-news-card mb-2">
                                    <div class="mb-1">
                                        <a href="@url" target="@target">
                                            @if (news.ListingImage != null)
                                            {
                                                @Html.PropertyFor(i => news.ListingImage)
                                            }
                                            else
                                            {
                                                @Html.PropertyFor(i => news.Image)
                                            }
                                        </a>
                                    </div>
                                    <h5 class="news-card_title b700">@Html.PropertyFor(i => news.Heading)</h5>
                                    <p class="truncate-overflow">@Html.PropertyFor(i => news.Description) </p>
                                    <a class="see-all-link cell shrink" href="@url" target="@target">Read more</a>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="side-listing cell small-12 large-2 mt-2">
            <div class="grid-x grid-margin-x">
                @Html.PropertyFor(i => i.CurrentPage.SideBlocks, new { HasContainer = false, HasItemContainer = false })
            </div>
        </div>
    </div>
</div>