@using ANA.Site.Models.ViewModels
@using ANA.Site.Models.CDC.Pages
@using ANA.Site.Models.CDC
@using Geta.Optimizely.Extensions;
@model IPageViewModel<CDCDetailPage>

@if (Model.CurrentPage.NavHack)
{
    Layout = "~/Views/Shared/Layouts/_CDCHackContent.cshtml";
}
else
{
    Layout = "~/Views/Shared/Layouts/_CDCContent.cshtml";
}


@if (Model.CurrentPage.PageLayout == PageLayout.TwoColumn)
{
    <div class="vert-grad-bottom cell small-12">
        <div class="inner-grad"></div>
    </div>

    <div class="main-left cell small-12 large-10">
        <div class="detail-hero-container mt-3 mb-3">
            <div class="detail-text">
                <div class="title h5">@Html.PropertyFor(i => i.CurrentPage.Heading)</div>
            </div>
            <div class="detail-hero">
                @Html.PropertyFor(i => i.CurrentPage.Image)
            </div>
        </div>
        <div class="overview mt-3 mb-3">
            <div class="copy small-12 mb-2">
                @Html.PropertyFor(i => i.CurrentPage.Content)
            </div>

            @if (Model.CurrentPage.Buttons.HasContent())
            {
                <div class="links grid-x mt-1 mb-3">
                    @await Html.PartialAsync("~/Views/CDC/Partials/_CDCButtonList.cshtml", Model.CurrentPage.Buttons)
                </div>
            }
        </div>
        <div class="grid-x">
            @Html.PropertyFor(i => i.CurrentPage.MainBlocks, new { HasContainer = false, HasItemContainer = false })
            @Html.PropertyFor(i => i.Layout.CDCHomePage.GlobalDetailPageBlocks, new { HasContainer = false, HasItemContainer = false })
        </div>
    </div>

    <div class="cell small-12 large-2">
        <div class="grid-x">
            @Html.PropertyFor(i => i.CurrentPage.SideBlocks, new { HasContainer = false, HasItemContainer = false })
        </div>
    </div>
}
else if (Model.CurrentPage.PageLayout == PageLayout.OneColumn)
{
    @await Html.PartialAsync("~/Views/CDC/Partials/_CDCHeadingInOneColumnLayout.cshtml", Model.CurrentPage)

    if (Model.CurrentPage.Content != null)
    {
        <div class="cell small-12 mb-1">
            @Html.PropertyFor(i => i.CurrentPage.Content)
        </div>
    }

    @Html.PropertyFor(i => i.CurrentPage.MainBlocks, new { HasContainer = false, HasItemContainer = false })
    if (!Model.CurrentPage.DisableGlobalBlocks)
    {
        @Html.PropertyFor(i => i.Layout.CDCHomePage.GlobalDetailPageBlocks, new { HasContainer = false, HasItemContainer = false })
    }
}
else
{
    if (Model.CurrentPage.DisplayContentText && Model.CurrentPage.Content != null)
    {
        <div class="cell small-12 mb-1">
            @Html.PropertyFor(i => i.CurrentPage.Content)
        </div>
    }

    @Html.PropertyFor(i => i.CurrentPage.MainBlocks, new { HasContainer = false, HasItemContainer = false })
    if (!Model.CurrentPage.DisableGlobalBlocks)
    {
        @Html.PropertyFor(i => i.Layout.CDCHomePage.GlobalDetailPageBlocks, new { HasContainer = false, HasItemContainer = false })
    }
}