@using ANA.Site.Models.CDC.Blocks
@using EPiServer.Web.Routing;
@using ANA.Site.Models.Media;
@model CDCIntroBlock

@{
    var style = Model.BackgroundColor == CDCIntroBlock.IntroBlockBackgroundColor.Purple
            ? "purple"
            : "light-blue";

    var image = !ContentReference.IsNullOrEmpty(Model.Image)
            ? EPiServer.ServiceLocation.ServiceLocator.Current.GetInstance<EPiServer.IContentLoader>().Get<MediaData>(Model.Image)
            : null;

    ImageFile imageFile = null;

    if (image is ImageFile)
    {
        imageFile = (ImageFile)image;
    }
}

<section class="on-the-go-no-gradient mb-1 cell small-12 @Model.GetCssClass()">
    <div class="grid-x">
        <div class="cell small-12 large-6">
            <h1 class="home-banner ph-16 @style">On-the-Go Resources</h1>
            <div class="on-the-go-no-gradient_content">
                @if (Model.Content != null && !Model.Content.IsEmpty)
                {
                    @Html.Raw(Model.Content)
                }
            </div>
        </div>
        <div class=" large-6 show-for-large grid-x">
            <div class="image__container small-12 grid-x">
                @if (imageFile != null)
                {
                    <img class="small-12" src="@UrlResolver.Current.GetUrl(imageFile.ContentLink)" alt="@imageFile.AltText" />
                }
            </div>
        </div>
    </div>
</section>