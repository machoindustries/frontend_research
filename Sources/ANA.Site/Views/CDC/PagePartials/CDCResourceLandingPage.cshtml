@using ANA.Site.Models.CDC.Pages.PartialViewModels
@using ANA.Site.Models.CDC.Pages
@using Geta.Optimizely.Extensions;
@model CDCResourceLandingPagePartialViewModel

@if (!Model.Resources.Any()) { return; }

<section id="@Model.CurrentContent.GetSectionName()" class="resource-section cell small-12">
    <div class="grid-container margin-x">
        <div class="text-full-width intro top-rule">
            <div class="hr cell small-12 mb-2"></div>
            <div class="small-12">
                <h2 class="h4">
                    @Html.PropertyFor(i => i.CurrentContent.Heading)
                </h2>
                <p>
                    @Html.PropertyFor(i => i.CurrentContent.Description)
                </p>
            </div>
        </div>
    </div>

    <section class="grid-container">
        @if (!string.IsNullOrEmpty(Model.CurrentContent.FeaturedTitle))
        {
            <div>
                <h6>@Html.PropertyFor(i => Model.CurrentContent.FeaturedTitle)</h6>
            </div>
        }
        <div class="grid-x">
            @if (Model.Resources.Count() <= 2 && Model.CurrentContent.FeaturedDescription != null)
            {
                <div class="cell small-12 large-6 two-col-resource-intro text-full-width">
                    @Html.PropertyFor(i => i.CurrentContent.FeaturedDescription)
                    @if (Model.ShowSeeAllLink)
                    {
                        SeeAllUrl(Model.CurrentContent);
                    }
                </div>
                <div class="two-col-resource cell small-12 large-6">
                    @{
                        await Resources(Model.Resources, true);
                    }
                </div>
            }
            else
            {
                if (Model.CurrentContent.FeaturedDescription != null)
                {
                    <div class="cell small-12 text-full-width">
                        @Html.PropertyFor(i => i.CurrentContent.FeaturedDescription)
                    </div>
                }
                <section class="cell small-12">
                    @{
                        await Resources(Model.Resources, Model.Resources.Count() == 3);
                    }
                    @if (Model.ShowSeeAllLink)
                    {
                        SeeAllUrl(Model.CurrentContent);
                    }
                </section>
            }
        </div>
    </section>
</section>

@functions {
async Task Resources(IEnumerable<CDCResource> resources, bool justify)
{
    <div class="grid-x video-cols">
        <div class="resource-container @(justify ? "align-justify" : "")">
            @foreach(var resource in resources)
            {
                @await Html.PartialAsync("~/Views/CDC/Partials/_CDCResourceCard.cshtml", resource)
            }
        </div>
    </div>
}

void SeeAllUrl(CDCResourceLandingPage resourceSection)
{
    <div class="cta-all-resources">
        <a href="@resourceSection.GetFriendlyUrl()" class="resource-link">See All @Html.PropertyFor(i => resourceSection.Heading)</a>
    </div>
}
}