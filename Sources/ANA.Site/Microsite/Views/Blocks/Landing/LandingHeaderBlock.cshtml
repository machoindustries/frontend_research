@using EPiServer.Web.Mvc.Html
@model ANA.Site.Microsite.Models.Blocks.Landing.LandingHeaderBlock

<div data-sticky-container>
    <div data-sticky data-margin-top='0'>
        <div class="@Model.GetWrapperClasses()">
            <div class="ana-header grid-x grid-margin-x @Model.GetThemeClasses()" style="@Model.GetThemeStyles()">
                <div class="cell small-12 ana-header--logo">
                    @Html.PropertyFor(m => m.Logo)
                </div>
            </div>
        </div>
    </div>
</div>