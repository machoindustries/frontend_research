        var url = @Model.Settings.SearchActionUrl;
        $("#searchforminput").keypress(function (event) {
            if (event.keyCode === 13) {
                //$('#searchform').attr('action', url + '?q=\'' + $('#searchforminput').val() + '\'');
                window.location.href = url + '?q=' + $('#searchforminput').val() + '';
            }
        });
    });

    </script>
