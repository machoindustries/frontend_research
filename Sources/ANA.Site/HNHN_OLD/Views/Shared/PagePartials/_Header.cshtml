@using EPiServer.Editor
@using EPiServer.Web
@using ANA.Site.HNHN.Models.Blocks
@using ANA.Site.HNHN.Business
@using ANA.Site.HNHN.Helpers
@using EPiServer.Core
@using ANA.Site.HNHN.Models.ViewModels
@using EPiServer.Web.Mvc.Html

@model ANA.Site.HNHN.Models.ViewModels.IPageViewModel<ANA.Site.HNHN.Models.Pages.BasePageData>

<header class="header">
    <div class="topbar hidden-xs">
        <div class="container">
            <div class="row">
                <div class="col-sm-4">
                    @*<a href="#" class="topbar__logo"><img src="/static/images/anae-logo-utility.svg" class="img-responsive" alt="ANA Enterprise"></a>*@
                    @if (Model.Settings.TopBarLogo != null)
                    {
                        var logoblock = Model.Settings.TopBarLogo.GetContent<LogoBlock>();
                        var logoViewModel = new LogoBlockViewModel(logoblock);
                        await Html.RenderPartialAsync("_LogoBlock", logoViewModel, new ViewDataDictionary(ViewData) { { "LinkClass", "topbar__logo" } });
                    }
                </div>
                <div class="col-sm-8">
                    <div class="topbar__right">
                        <ul class="topbar__links">
                            @Html.PropertyFor(m => m.Settings.UtilityNav)
                            @*<li><a href="#">Beta</a></li>
                                <li><a href="#">Contact Us</a></li>
                                <li><a href="#">Join ANA</a></li>*@
                        </ul>

                        @if (Model.Settings.SocialLinks.Any() || ContentHelper.PageIsInEditMode())
                        {
                            <ul class="social-list" @Html.EditAttributes(m => m.Settings.SocialLinks)>
                                @foreach (var link in Model.Settings.SocialLinks.GetContentItems<SocialLinkBlock>())
                                {
                                    await Html.RenderPartialAsync("SocialLinkBlock", link);
                                }
                            </ul>
                        }
                        @*<ul class="social-list">
                                <li><a href="#"><img src="/static/images/icons/twitter.svg" alt="Twitter"></a></li>
                                <li><a href="#"><img src="/static/images/icons/facebook.svg" alt="facebook"></a></li>
                                <li><a href="#"><img src="/static/images/icons/instagram.svg" alt="instagram"></a></li>
                                <li><a href="#"><img src="/static/images/icons/linkedin.svg" alt="linkedin"></a></li>
                            </ul>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    @{
        string navClass = Model.CurrentPage.ContentLink.CompareToIgnoreWorkID(ContentReference.StartPage) ? "navbar--inverted" : "navbar--default";
    }
    <nav class="navbar navbar-hnhn @navClass" role="navigation">

        <div class="container">
            <!-- Brand and toggle get grouped for better mobile display -->
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-ex1-collapse">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @*<a class="navbar-brand" href="#">
                        <img src="/static/images/hnhn-logo-reversed.svg" class="img-responsive" alt="HNHN Logo">
                    </a>*@
                @Html.PropertyFor(m => m.Settings.NavBarLogo, new { Tag = "NavBarLogo" })
            </div>
            <ul class="navbar-nav nav hightlight-nav">
                <li>
                    @if (Model.Settings.NavigationCTA != null)
                    {
                        var ctalink = Model.Settings.NavigationCTA.GetContent<CallToActionBlock>();
                        <a href="@ctalink.Link" class="btn btn-danger">@ctalink.Text</a>
                    }
                    @*<a href="#" class="btn btn-danger">Join the Challenge</a>*@
                </li>
                <li class="visible-md visible-lg">
                    <a href="#" class="search-toggle" id="search_toggle" @Html.EditAttributes(m => m.Settings.SearchPage)>
                        <img src="/hnhn_old/images/icons/search-icon.svg" alt="Search">
                    </a>
                </li>
            </ul>
            <!-- Collect the nav links, forms, and other content for toggling -->
            <div class="collapse navbar-collapse navbar-ex1-collapse">
                @{
                   await Html.RenderPartialAsync("_Navigation");
                }

                <div class="visible-xs visible-sm">
                    <div class="search-form">
                        <div class="form-group has-feedback">
                            <input type="text" class="form-control">
                            <button class="form-control-feedback">
                                <img src="/hnhn_old/images/icons/search-icon.svg" alt="Search">
                            </button>
                        </div>
                    </div>
                </div>
                <div class="topbar__right visible-xs">
                    <ul class="topbar__links">
                        @Html.PropertyFor(m => m.Settings.UtilityNav)
                        @*<li><a href="#">Beta</a></li>
                            <li><a href="#">Contact Us</a></li>
                            <li><a href="#">Join ANA</a></li>*@
                    </ul>
                    <br>
                    @if (Model.Settings.SocialLinks.Any())
                    {
                        <ul class="social-list">
                            @foreach (var link in Model.Settings.SocialLinks.GetContentItems<SocialLinkBlock>())
                            {
                                await Html.RenderPartialAsync("SocialLinkBlock", link);
                            }
                        </ul>
                    }
                    @*<ul class="social-list">
                            <li><a href="#"><img src="/static/images/icons/twitter.svg" alt="Twitter"></a></li>
                            <li><a href="#"><img src="/static/images/icons/facebook.svg" alt="facebook"></a></li>
                            <li><a href="#"><img src="/static/images/icons/instagram.svg" alt="instagram"></a></li>
                            <li><a href="#"><img src="/static/images/icons/linkedin.svg" alt="linkedin"></a></li>
                        </ul>*@
                </div>
            </div><!-- /.navbar-collapse -->


        </div> <!-- END .container -->
    </nav>
    @*@using (Html.BeginForm(null, null, PageEditing.PageIsInEditMode ? FormMethod.Post : FormMethod.Get, new { @action = Model.Settings.SearchActionUrl, @class = "search-form search-form--lg" }))
    {
        <div class="container">
            <div class="col-lg-10 col-lg-offset-1">
                <label for="" class="sr-only">Search Input</label>
                <input type="search" class="search-form__input " id="searchforminput" placeholder="Search..">
            </div>
        </div>
    }*@
    <div class="search-form search-form--lg" action="#">
            <div class="container">
                <div class="col-lg-10 col-lg-offset-1">
                    <label for="" class="sr-only">Search Input</label>
                    <input type="search" class="search-form__input " id="searchforminput" placeholder="Search..">
                </div>
            </div>
        </div>

</header>
