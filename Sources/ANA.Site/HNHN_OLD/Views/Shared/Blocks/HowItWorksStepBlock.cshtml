@using EPiServer.Core
@using EPiServer.Editor
@using EPiServer.Web.Mvc.Html
@using ANA.Site.HNHN.Business
@using ANA.Site.HNHN.Helpers
@using ANA.Site.HNHN.Models.Blocks.Infographics
@using EPiServer.Web.Routing
@using EPiServer.ServiceLocation

@model ANA.Site.HNHN.Models.Blocks.Infographics.HowItWorksStepBlock

@{ 
    var _UrlResolver = ServiceLocator.Current.GetInstance<UrlResolver>();
}

<li>
    @Html.PropertyFor(m => m.Text, new { CustomTag = "span" })
    @if (Model.Icon != null || ContentHelper.PageIsInEditMode())
    {
        <span class="icon-hnhn" @Html.EditAttributes(m => m.Icon)>
            <img src="@_UrlResolver.GetUrl(Model.Icon)" alt="" />
        </span>
    }
    @*Take a personalized health risk assessment. <span class="icon-hnhn"><img src="/static/images/icons/health-risk-icon.svg" alt="health risk"></span>*@
    @if (Model.SubItems?.FirstOrDefault() != null || ContentHelper.PageIsInEditMode())
    {
        <ul class="focus-area-list" @Html.EditAttributes(m => m.SubItems)>
            @foreach (var item in Model.SubItems.GetContentItems<HowItWorksSubItemBlock>())
            {
                Html.RenderContentData(item, false);
            }
        </ul>
    }
</li>
