}

@if (ContentHelper.PageIsInEditMode())
{
    <style type="text/css">
        .healthy-nation .link-edit {
            display: none;
        }

        .preview-display .healthy-nation .edit-box {
            margin-left: 30px;
        }

        .preview-display .healthy-nation .link-edit {
            display: block;
            font-size: 1.0rem;
            height: 20px;
            text-align: center;
            width: 40px;
            z-index: 999;
        }
    </style>
}

