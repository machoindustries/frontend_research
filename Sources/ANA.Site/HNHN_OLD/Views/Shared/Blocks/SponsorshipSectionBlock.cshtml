        @{
            string columnSize = Defs.Layout.GetCalloutColumnClass(Defs.Layout.BootstrapColumnWidth.Small);
            string groupClass = "columns";
            int maxItems = 3;

            @if (Model.ContentItems != null && Model.ContentItems.Items.Any())
            {
                var contentItems = Model.ContentItems.Items.GetContentItems<BaseBlockData>();
                int rowCount = (int)Math.Ceiling(contentItems.Count() / (float)maxItems);

                for (int i = 0; i < rowCount; i++)
                {
                    <div class="row @groupClass">
                        @{
                            var currentItems = contentItems.Skip(i * maxItems).Take(maxItems);
                            int colsCount = (12 / currentItems.Count());
                            int currentCol = 0;
                            foreach (var item in currentItems)
                            {
                                <div class="col-@columnSize-@colsCount wow @Html.GetContentColumnFadeClass(currentCol, maxItems)" data-wow-duration="1.3s">
                                    @{
                                        Html.RenderContentData(item, true);
                                    }
                                </div>
                                currentCol++;
                            }
                        }
                    </div>
                }
            }
        }




