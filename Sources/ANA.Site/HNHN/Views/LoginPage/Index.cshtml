@using ANA_HNHN.Helpers
@model ANA_HNHN.Models.ViewModels.LoginPageViewModel
@inherits ANA_HNHN.Views.AlloyPageBase<ANA_HNHN.Models.ViewModels.LoginPageViewModel>

<section class="login section--login">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-md-6 d-none d-md-flex flex-column pe-5">
				@Html.PropertyFor(x => x.CurrentPage.ScriptTitle)
				@Html.PropertyFor(x => x.CurrentPage.Subtext)
			</div>
			<div class="col-md-6">
				<h2>
					@Html.PropertyFor(x => x.CurrentPage.FormHeading)
				</h2>
				@Html.PropertyFor(x => x.CurrentPage.FormSubtext)
				@if (!string.IsNullOrEmpty(Model.RecoverPasswordUrl))
				{
					<p style="text-align: center;">
						@Model.ForgotPassword
						<a target="_blank" href="@Model.RecoverPasswordUrl">@Html.Translate("/loginpage/resetpassword")</a>
					</p>
				}
				@if (Model.ShowErrorMessage || PageHelper.IsInEditMode())
				{
					<p>
						@Html.PropertyFor(x => x.CurrentPage.ErrorMessage)
					</p>
				}
				@using (Html.BeginForm(FormMethod.Post))
				{
					@Html.ValidationSummary()
					@Html.TextBoxFor(x => x.UserName, new { placeholder = Html.Translate("/loginpage/username") })
					@Html.PasswordFor(x => x.Password, new { placeholder = Html.Translate("/loginpage/password") })
					<input type="submit" value="@Html.Translate("/loginpage/submit")" />
				}
			</div>
		</div>
	</div>
</section>