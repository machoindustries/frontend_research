@using ANA_HNHN.Business.EditorDescriptors
@using ANA_HNHN.Models.Constants
@using ANA_HNHN.Models.Enums
@using ANA_HNHN.Models.Pages
@using Brightfind.Helper
@using EPiServer.Core.Internal
@using EPiServer.ServiceLocation
@using Geta.Optimizely.Categories
@using ANA_HNHN.Models.ViewModels
@model BlogListingPageViewModel
@inherits ANA_HNHN.Views.AlloyPageBase<BlogListingPageViewModel>
@{
    var searchActionUrl = UrlResolver.Current.GetUrl(Model.CurrentPage);
}

<link href="/assets/hnhn/css/search.css" rel="stylesheet" />
<input type="hidden" id="searchActionUrl" name="name" value="@searchActionUrl" />

@if (Model.CurrentPage != null && Model.CurrentPage.AdditionalLayer != null && Model.CurrentPage.AdditionalLayer.Count > 0)
{
    @Html.PropertyFor(x => x.CurrentPage.AdditionalLayer)
}
<section class="search">
    <div class="container">
        <h2>@Model.CurrentPage.Title</h2>
        <div class="row align-items-center mb-4">
            <div class="col-lg-5">
                <div class="search__search-box">
                    <input type="text" class="form-control m-0" id="searchField" placeholder="Search">
                    <button type="button" id="searchButtonSearchPage" class="search__search-icon" aria-label="Search Button">
                        <img src="/assets/hnhn/img/search_icon.svg" alt="Search Icon" />
                    </button>
                </div>
            </div>
            <div class="col-lg-7 d-lg-flex gap-4 align-items-center justify-content-start justify-content-lg-end">
                <span style="display: none" id="hits">@Model.Hits?.Count()</span>
                <span class="search__select">
                    @Html.Translate("/common/showing") <span id="showingFrom">@Model.ShowingFrom</span> @Html.Translate("/common/to") <span id="showingTo">@Model.ShowingTo</span>
                    @Html.Translate("/common/of") <span id="totalResultsCount">@Model.TotalHits</span>
                    @Html.Translate("/common/pagesize")
                    @Html.DropDownList(
                             "ps",
                             IntegerConstants.PageSizesBySix
                             .Select(x => new SelectListItem(
                             x.ToString(),
                             x.ToString(),
                             x.Equals(Model.Pagination.PageSize))),
                             new { id = "resultsPerPageSelect", @class = "mb-0" })
                </span>
                <span class="search__select">
                    @Html.Translate("/common/sortby"):
                    @Html.DropDownList(
                             "o",
                             Enum.GetValues<SortType>()
                             .Select(x => new SelectListItem(
                             LocalizationService.Current.GetString($"/property/enum/SortType/{x}"),
                             x.ToString().ToLower(),
                             Model.Criteria.Order.HasValue ? x.Equals(Model.Criteria.Order) : x.Equals(Model.CurrentPage.DefaultSortOrder))),
                             new { @class = "sort-by mb-0", id = "sortGlobalPage" })
                </span>
            </div>
        </div>
        <div class="row search__filters__data">
            <div class="col-lg-3 search__filters">
                <div class="search__filters--wrap">
                    <partial name="Facets" model="Model.Facets" view-data="ViewData" />
                    <partial name="SearchTimeFrame" model="Model.Criteria" />
                </div>
            </div>
            <button type="button" id="searchButtonMobile" class="btn btn-secondary d-block d-lg-none search__btn-filter">Filters</button>
            <div class="col-lg-9">
                <div id="search__grid">
                    <div id="loader"></div>
                    <partial name="BlogListingResults" model="Model.Hits" view-data="ViewData" />
                    @if (Model.Hits.Count() <= 0)
                    {
                        <div id="noResultsMessage">
                            @Html.Raw(Model.CurrentPage.NoResults)
                        </div>
                    }
                    else
                    {
                        <div style="display: none" id="noResultsMessage">
                            @Html.Raw(Model.CurrentPage.NoResults)
                        </div>
                    }
                    <partial name="HNHNPagination" model="Model.Pagination" />
                </div>
            </div>

        </div>
    </div>
</section>
<script src="/assets/hnhn/js/search.js"></script>
